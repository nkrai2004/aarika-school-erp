rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sameUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isPlatformAdmin() {
      return signedIn() && userDoc() != null && userDoc().roleId == 'SUPER_ADMIN';
    }

    function sameSchool(schoolId) {
      return signedIn() && userDoc() != null && userDoc().schoolId == schoolId;
    }

    match /users/{uid} {
      allow read: if sameUser(uid) || isPlatformAdmin();
      allow create: if sameUser(uid);
      allow update: if sameUser(uid) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /schools/{schoolId} {
      allow read: if sameSchool(schoolId) || isPlatformAdmin();
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /schoolSettings/{schoolId} {
      allow read: if sameSchool(schoolId) || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
